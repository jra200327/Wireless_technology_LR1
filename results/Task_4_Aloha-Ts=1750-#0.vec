attr experiment Task_4_Aloha
attr inifile omnetpp.ini
attr iterationvars $Ts=1750
attr iterationvarsd Ts=1750
attr iterationvarsf Ts=1750-
attr measurement $Ts=1750
attr network WTIS_Lab_1_Network
attr processid 17344
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 5
attr seedset 5
itervar Ts 1750
config image-path ../../../images
config extends Lab_1
config *.host*.wlan[0].radio.receiver.ignoreInterference false
config *.numTxNodes 25
config *.hostTX*.app[0].messageLength "int(uniform(1B, 2000B))"
config *.hostTX*.app[0].sendInterval exponential(1750ms)
config network WTIS_Lab_1_Network
config sim-time-limit 100s
config *.host*.ipv4.arp.typename GlobalArp
config *.hostTX*.app[0].startTime "uniform(0s, 1s)"
config *.hostTX[*].app[0].rng-0 index
config *.radioMedium.sameTransmissionStartTimeCheck "\"warning\""
config *.hostTX*.numApps 1
config *.hostTX*.app[0].typename UdpBasicApp
config *.hostTX*.app[0].destAddresses "\"hostRX\""
config *.hostTX*.app[0].destPort 5000
config *.hostTX*.app[0].packetName "\"UDPData\""
config *.hostTX*.*.**.vector-recording false
config *.hostRX.numApps 1
config *.hostRX.app[0].typename UdpSink
config *.hostRX.app[0].localPort 5000
config *.hostRX.app[0].endToEndDelay:vector.vector-recording true
config *.hostRX.app[0].endToEndDelay.result-recording-modes -vector,-histogram,+mean,+max
config *.hostRX.*.**.vector-recording false
config *.host*.wlan[0].typename AckingWirelessInterface
config *.host*.wlan[0].mac.useAck false
config *.host*.wlan[0].mac.headerLength 23B
config *.host*.**.bitrate 4000kbps
config *.host*.wlan[0].radio.typename GenericUnitDiskRadio
config *.host*.wlan[0].radio.transmitter.analogModel.communicationRange 250m
config *.host*.wlan[0].radio.transmitter.analogModel.interferenceRange 250m
config *.host*.wlan[0].radio.displayCommunicationRange true
config *.host*.wlan[0].radio.displayInterferenceRange true
config *.host*.wlan[0].radio.energyConsumer.typename StateBasedEpEnergyConsumer
config *.host*.wlan[0].radio.energyConsumer.offPowerConsumption 0mW
config *.host*.wlan[0].radio.energyConsumer.sleepPowerConsumption 0.005mW
config *.host*.wlan[0].radio.energyConsumer.switchingPowerConsumption 5mW
config *.host*.wlan[0].radio.energyConsumer.receiverReceivingPowerConsumption 0mW
config *.host*.wlan[0].radio.energyConsumer.receiverIdlePowerConsumption receiverReceivingPowerConsumption
config *.host*.wlan[0].radio.energyConsumer.receiverBusyPowerConsumption receiverReceivingPowerConsumption
config *.host*.wlan[0].radio.energyConsumer.transmitterTransmittingPowerConsumption 75mW
config *.host*.wlan[0].radio.energyConsumer.transmitterIdlePowerConsumption transmitterTransmittingPowerConsumption
config *.host*.energyStorage.typename IdealEpEnergyStorage
config *.radioMedium.mediumLimitCache.maxTransmissionDuration 1s
config num-rngs 25

